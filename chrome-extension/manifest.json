{
  "manifest_version": 3,
  "name": "Aura Device Master",
  "version": "0.8.1",
  "description": "Local Alexa device manager with backups, filters, safe actions and German/English interface.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://alexa.amazon.de/*",
    "https://alexa.amazon.com/*",
    "https://alexa.amazon.co.uk/*",
    "https://alexa.amazon.fr/*",
    "https://alexa.amazon.it/*",
    "https://alexa.amazon.es/*",
    "https://alexa.amazon.ca/*",
    "https://alexa.amazon.com.au/*",
    "https://alexa.amazon.co.jp/*",
    "https://alexa.amazon.in/*",
    "https://alexa.amazon.com.br/*",
    "https://alexa.amazon.com.mx/*",
    "https://pitangui.amazon.com/*",
    "https://layla.amazon.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon128.png",
        "icon48.png",
        "icon32.png",
        "icon16.png",
        "*.jpg"
      ],
      "matches": [
        "https://alexa.amazon.de/*",
        "https://alexa.amazon.com/*",
        "https://alexa.amazon.co.uk/*",
        "https://alexa.amazon.fr/*",
        "https://alexa.amazon.it/*",
        "https://alexa.amazon.es/*",
        "https://alexa.amazon.ca/*",
        "https://alexa.amazon.com.au/*",
        "https://alexa.amazon.co.jp/*",
        "https://alexa.amazon.in/*",
        "https://alexa.amazon.com.br/*",
        "https://alexa.amazon.com.mx/*",
        "https://pitangui.amazon.com/*",
        "https://layla.amazon.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Aura Device Master",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
